# If you are reading this ⚠️ DO NOT PUT REAL KEYS HERE ⚠️ use vi .env instead

API_ID=
API_HASH=
TOKEN=
STRING1=
STRING2=
STRING3=
STRING4=
STRING5=
STRING6=
STRING7=
STRING8=
STRING9=
STRING10=
# Docker Compose du repo : Mongo est le service "mongo" (voir docker-compose.yml).
# Mets la même base que DB_NAME (ex. MusicBot) :
# MONGO_URI=mongodb://mongo:27017/MusicBot
#
# Mongo sur l’hôte VPS à la place : ajoute dans le service tgmusic
#   extra_hosts: ["host.docker.internal:host-gateway"]
# puis par ex. MONGO_URI=mongodb://USER:PASS@host.docker.internal:27017/DB_NAME?authSource=admin
MONGO_URI=mongodb://mongo:27017/MusicBot
API_URL=https://tgmusic.fallenapi.fun
API_KEY=
SONG_DURATION_LIMIT=3600
OWNER_ID=
LOGGER_ID=
DEFAULT_SERVICE=youtube
DOWNLOADS_DIR=
DB_NAME=MusicBot
# Optional proxy used by yt-dlp, e.g. socks5://100.114.103.46:1080
PROXY=
# Option A — URL(s) brutes (Pastebin raw, etc.) : moins idéal niveau vie privée.
COOKIES_URL=
# Option B — fichier(s) monté(s), séparés par des virgules.
# COOKIES_PATH=/home/app/cookies/youtube.txt
# Option C — dossier monté : tous les *.txt valides sont essayés du plus récent au plus ancien.
# COOKIES_DIR=/home/app/cookies
SUPPORT_GROUP=
SUPPORT_CHANNEL=
DEVS=
